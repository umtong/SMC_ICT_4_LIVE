{
  "name": "SMC/ICT 4 - Prebuilt NautilusTrader Research",
  "image": "ghcr.io/umtong/smc-ict-4-live-research:foundation-1.0.0",
  "remoteUser": "vscode",
  "containerEnv": {
    "SMC4_PREBUILT_ENV": "1",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONUNBUFFERED": "1"
  },
  "remoteEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}/src"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/opt/smc4/.venv/bin/python",
        "python.terminal.activateEnvironment": false,
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "smc4 doctor",
  "waitFor": "postCreateCommand"
}
