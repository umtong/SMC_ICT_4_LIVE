  "workflow": "name: candidate-diagonal-channel-auction-v1\n\non:\n  workflow_dispatch:\n  push:\n    branches: [\"research_ML_thinking\"]\n    paths:\n      - \"research/candidate-diagonal-channel-auction-v1/**\"\n      - \"!research/candidate-diagonal-channel-auction-v1/.latest-run\"\n      - \".github/workflows/candidate-diagonal-channel-auction-v1.yml\"\n\nconcurrency:\n  group: candidate-diagonal-channel-auction-v1\n  cancel-in-progress: true\n\npermissions:\n  contents: write\n  packages: read\n\ndefaults:\n  run:\n    shell: bash\n\njobs:\n  announce:\n    runs-on: ubuntu-24.04\n    steps:\n      - uses: actions/checkout@v4\n      - run: |\n          set -euo pipefail\n          git config user.name \"github-actions[bot]\"\n          git config user.email \"41898282+github-actions[bot]@users.noreply.github.com\"\n          printf '{\"run_id\":%s,\"head_sha\":\"%s\",\"created_at\":\"%s\"}\\n' \"$GITHUB_RUN_ID\" \"$GITHUB_SHA\" \"$(date -u +%FT%TZ)\" > research/candidate-diagonal-channel-auction-v1/.latest-run\n          git add research/candidate-diagonal-channel-auction-v1/.latest-run\n          git commit -m \"Record diagonal auction run $GITHUB_RUN_ID\" || true\n          git push origin HEAD:research_ML_thinking\n\n  core-check:\n    runs-on: ubuntu-24.04\n    timeout-minutes: 30\n    container:\n      image: ghcr.io/umtong/smc-ict-4-live-research@sha256:8f4de8a2b2fa28c3f424d114969b1c07765206708f24613b86896ced67532469\n      options: --user 0\n    env:\n      PYTHONPATH: research/candidate-diagonal-channel-auction-v1:research/candidate-hierarchical-liquidity-bpr-v1:research/candidate-auction-dislocation-confluence-v1:research/candidate-derivatives-dislocation-v1:research/candidate-liquidity-displacement-v1:research/candidate-auction-episode-policy:research/candidate-auction-event-v2:research/candidate-direct-auction-policy:research/candidate-easychart_re1:research/candidate-easychart-v5:research/candidate-easychart-v3\n      PYTHONUNBUFFERED: \"1\"\n    steps:\n      - uses: actions/checkout@v4\n      - run: |\n          set -euo pipefail\n          python -m py_compile research/candidate-diagonal-channel-auction-v1/diagonal_channel_auction.py research/candidate-diagonal-channel-auction-v1/run_research.py\n          python - <<'PY'\n          from diagonal_channel_auction import POLICY, PIVOT_SPANS\n          assert 'SWEEP_RECLAIM' in POLICY and 'BODY_BREAK_HOLD_FIRST_RETEST' in POLICY\n          assert set(PIVOT_SPANS)=={5,15,60}\n          print(POLICY)\n          PY\n\n  harvest:\n    needs: core-check\n    strategy:\n      fail-fast: false\n      max-parallel: 4\n      matrix:\n        include:\n          - {period: dev-2024-feb, start: 2024-02-01, end: 2024-02-08}\n          - {period: dev-2024-aug, start: 2024-08-01, end: 2024-08-08}\n          - {period: dev-2025-feb, start: 2025-02-01, end: 2025-02-08}\n          - {period: dev-2025-aug, start: 2025-08-01, end: 2025-08-08}\n    runs-on: ubuntu-24.04\n    timeout-minutes: 180\n    container:\n      image: ghcr.io/umtong/smc-ict-4-live-research@sha256:8f4de8a2b2fa28c3f424d114969b1c07765206708f24613b86896ced67532469\n      options: --user 0\n    env:\n      PYTHONPATH: research/candidate-diagonal-channel-auction-v1:research/candidate-hierarchical-liquidity-bpr-v1:research/candidate-auction-dislocation-confluence-v1:research/candidate-derivatives-dislocation-v1:research/candidate-liquidity-displacement-v1:research/candidate-auction-episode-policy:research/candidate-auction-event-v2:research/candidate-direct-auction-policy:research/candidate-easychart_re1:research/candidate-easychart-v5:research/candidate-easychart-v3\n      PYTHONUNBUFFERED: \"1\"\n      CACHE: .cache/candidate-diagonal-channel-auction-v1/${{ matrix.period }}\n      OUT: artifacts/candidate-diagonal-channel-auction-v1/${{ matrix.period }}\n      START: ${{ matrix.start }}\n      END: ${{ matrix.end }}\n    steps:\n      - uses: actions/checkout@v4\n      - name: Harvest causal diagonal interactions\n        run: |\n          set -euo pipefail\n          mkdir -p \"$CACHE\" \"$OUT\"\n          python research/candidate-diagonal-channel-auction-v1/run_research.py --start \"$START\" --end \"$END\" --warmup-days 30 --symbols BTCUSDT ETHUSDT SOLUSDT XRPUSDT --cache \"$CACHE\" --output \"$OUT\"\n      - name: Verify causal diagonal geometry\n        run: |\n          set -euo pipefail\n          python - <<'PY'\n          import os\n          from pathlib import Path\n          import pandas as pd\n          frame=pd.read_csv(Path(os.environ['OUT'])/'diagonal_actions.csv')\n          if frame.empty:\n              raise RuntimeError('empty diagonal action universe')\n          if frame.action_id.duplicated().any() or frame.episode_id.duplicated().any():\n              raise RuntimeError('duplicate diagonal identity')\n          filled=frame[frame.fill_state.astype(str).str.startswith('FILLED')]\n          if not (pd.to_numeric(filled.fill_time_ns)>pd.to_numeric(filled.emission_time_ns)).all():\n              raise RuntimeError('entry not strictly after completed response')\n          geometry=((frame.side=='LONG')&(frame.stop<frame.entry)&(frame.target>frame.entry))|((frame.side=='SHORT')&(frame.stop>frame.entry)&(frame.target<frame.entry))\n          if not geometry.all():\n              raise RuntimeError('invalid directional geometry')\n          if not (pd.to_numeric(frame.gross_rr)>=1.0).all():\n              raise RuntimeError('gross RR below user rule')\n          print(frame.groupby(['event_type','line_side','line_timeframe_minutes','channel_present']).outcome.value_counts())\n          PY\n      - name: Preserve diagonal action universe\n        if: always()\n        uses: actions/upload-artifact@v4\n        with:\n          name: diagonal-channel-auction-v1-${{ matrix.period }}\n          path: artifacts/candidate-diagonal-channel-auction-v1/${{ matrix.period }}/**\n          if-no-files-found: warn\n          retention-days: 30\n          compression-level: 6\n",
