def _feature(row: pd.Series) -> router.FeatureObservation:
    values = {name: float(row[name]) for name in FEATURE_COLUMNS}
    ready = _bool(row["feature_ready"]) and all(_finite(v) for v in values.values())
    return router.FeatureObservation(
        observed_time_ns=int(row["observed_time_ns"]),
        ready=ready,
        **values,
    )


def _bar(row: pd.Series) -> router.BarObservation:
    ts = pd.Timestamp(row["close_time_dt"])
    if ts.tzinfo is None:
        ts = ts.tz_localize("UTC")
    else:
        ts = ts.tz_convert("UTC")
    return router.BarObservation(
        ts_event=int(ts.value),
        open=float(row["open"]),
        high=float(row["high"]),
        low=float(row["low"]),
        close=float(row["close"]),
        volume=float(row["volume"]),
    )


def _family_decision(
    family: str,
    symbol: str,
    bars: list[router.BarObservation],
    feature: router.FeatureObservation,
    config: router.RouteConfig,
) -> router.RouteDecision:
    if family == "continuation":
        return router.classify_continuation(symbol, bars, feature, config)
    if family == "absorption":
        return router.classify_absorption(symbol, bars, feature, config)
    raise ValueError(f"unknown family {family!r}")


def _return_path(
    frame: pd.DataFrame,
    event_index: int,
    side: int,
    objective: float,
    stop: float,
) -> dict[str, Any]:
    entry_index = event_index + 1
    result: dict[str, Any] = {
        "entry_index": entry_index,
        "entry_time": None,
        "entry_price": math.nan,
        "actual_geometry_valid": False,
        "objective_gross_bps": math.nan,
        "stop_gross_bps": math.nan,
        "objective_net_bps": math.nan,
        "planned_loss_cost_inclusive_bps": math.nan,
        "cost_aware_reward_r": math.nan,
        "objective_exceeds_round_trip_cost": False,
    }
    if entry_index >= len(frame) or side not in (-1, 1):
        return result

    entry_row = frame.iloc[entry_index]
    entry_time = pd.Timestamp(entry_row["open_time_dt"])
    if entry_time.tzinfo is None:
        entry_time = entry_time.tz_localize("UTC")
    else:
        entry_time = entry_time.tz_convert("UTC")
    entry = float(entry_row["open"])
    result["entry_time"] = entry_time.isoformat()
    result["entry_price"] = entry

    if side > 0:
        reward = float(objective) / entry - 1.0
        risk = 1.0 - float(stop) / entry
        geometry = 0.0 < float(stop) < entry < float(objective)
    else:
        reward = 1.0 - float(objective) / entry
        risk = float(stop) / entry - 1.0
        geometry = 0.0 < float(objective) < entry < float(stop)
    reward_bps = reward * 10_000.0
    risk_bps = risk * 10_000.0
    net_reward_bps = reward_bps - ROUND_TRIP_COST_BPS
    planned_loss_bps = risk_bps + ROUND_TRIP_COST_BPS
    result.update({
        "actual_geometry_valid": bool(geometry and reward > 0.0 and risk > 0.0),
        "objective_gross_bps": reward_bps,
        "stop_gross_bps": risk_bps,
        "objective_net_bps": net_reward_bps,
