                    {
                        "index": index,
                        "time": timestamp,
                        "pool_id": pool.pool_id,
                        "pool_side": pool.side,
                        "side": trade_side,
                        "level": pool.level,
                        "extreme": extreme,
                        "penetration_atr": penetration,
                        "touches": pool.touches,
                        "age": age,
                        "prominence_atr": pool.prominence_atr,
                    },
                )
            # The first meaningful penetration consumes the pool even if it was
            # too young, insufficiently prominent, or accepted rather than rejected.
            pool.active = False

    intents: list[Intent] = []
    diagnostics: list[dict[str, Any]] = []
    for event in raw_events:
        sweep_index = int(event["index"])
        side = int(event["side"])
        pre = data.iloc[
            max(0, sweep_index - config.pre_sweep_structure_minutes) : sweep_index
        ]
        structure = float(pre["high"].max() if side == 1 else pre["low"].min())
        confirmed = False
        for signal_index in range(
            sweep_index + 1,
            min(sweep_index + config.sweep_confirmation_minutes + 1, len(data) - 1),
        ):
            row = data.iloc[signal_index]
            atr = float(row["atr"])
            if not math.isfinite(atr) or atr <= 0:
                continue
            broken = float(row["close"]) > structure if side == 1 else float(row["close"]) < structure
            body = side * float(row["close"] - row["open"]) / atr
            flow = side * float(row["flow_60s"])
            close_location = directional_close_location(row, side)
            burst = float(data["notional_burst_xday_60s"].iloc[signal_index])
            trend = side * float(row["close"] - data["close"].iloc[signal_index - 240]) / atr
            if broken:
                # The first structural response is the causal quality test. A weak
                # first break invalidates the setup; waiting for a later large bar
                # would convert confirmation into price chasing.
                if (
                    body >= config.sweep_body_atr
                    and flow >= config.sweep_flow_60s
                    and close_location >= config.sweep_close_location
                    and burst >= config.sweep_notional_burst_60s
                    and trend >= config.sweep_trend_240m_atr
                ):
                    stop = float(event["extreme"]) - side * config.sweep_stop_buffer_atr * float(
                        data["atr"].iloc[sweep_index],
                    )
                    intents.append(
                        Intent(
                            scenario="SWING_FAILED_AUCTION_RESUMPTION",
                            side=side,
                            signal_index=signal_index,
                            entry_index=signal_index + 1,
                            stop_level=stop,
                            event_indices=(sweep_index,),
                            details={
                                **event,
                                "structure": structure,
                                "body_atr": body,
                                "flow_60s": flow,
                                "notional_burst_60s": burst,
                                "trend_240m_atr": trend,
                                "close_location": close_location,
                            },
                        ),
                    )
                    confirmed = True
                break
        diagnostics.append({**event, "confirmed": confirmed})
    return cluster_intents(intents, config.parent_cluster_minutes), diagnostics


def detect_trend_intents(
    data: pd.DataFrame,
    evaluation_start: pd.Timestamp,
    evaluation_end: pd.Timestamp,
    config: Config,
) -> tuple[list[Intent], list[dict[str, Any]]]:
    intents: list[Intent] = []
    diagnostics: list[dict[str, Any]] = []
    start_index = max(
        config.trend_lookback_minutes,
        config.pullback_lookback_minutes,
        config.trend_stop_minutes,
    ) + 1
    for signal_index in range(start_index, len(data) - 1):
        timestamp = data.index[signal_index]
        if not evaluation_start <= timestamp <= evaluation_end:
            continue
        row = data.iloc[signal_index]
        atr = float(row["atr"])
        if not math.isfinite(atr) or atr <= 0:
            continue
        raw_trend = float(
            (row["close"] - data["close"].iloc[signal_index - config.trend_lookback_minutes]) / atr,
        )
        side = 1 if raw_trend > 0 else -1
        trend = side * raw_trend
        pullback = side * float(
            (
                data["close"].iloc[signal_index - 1]
                - data["close"].iloc[signal_index - config.pullback_lookback_minutes]
            )
            / atr,
        )
        structure_slice = data.iloc[
            signal_index - config.trend_structure_minutes : signal_index
        ]
        structure = float(
            structure_slice["high"].max() if side == 1 else structure_slice["low"].min(),
        )
        broken = float(row["close"]) > structure if side == 1 else float(row["close"]) < structure
        body = side * float(row["close"] - row["open"]) / atr
        flow = side * float(row["flow_60s"])
        burst = float(data["notional_burst_xday_60s"].iloc[signal_index])
        close_location = directional_close_location(row, side)
        oi_change = side * float(data["oi_change_xday_15m"].iloc[signal_index])
        absorption = float(row["absorption_60s"])
        efficiency = float(row["eff_60s"])
        acceleration = side * float(row["flow_accel_15_vs_prior45"])

        passed = (
            trend >= config.trend_min_displacement_atr
            and pullback <= config.trend_max_pullback_atr
            and broken
            and body >= config.trend_body_atr
            and flow >= config.trend_flow_60s
            and burst >= config.trend_notional_burst_60s
            and close_location >= config.trend_close_location
            and oi_change >= config.trend_oi_15m_min
            and absorption >= config.trend_absorption_60s_min
            and efficiency <= config.trend_efficiency_60s_max
            and acceleration <= config.trend_flow_acceleration_max
        )
        if not passed:
            continue
        stop_slice = data.iloc[signal_index - config.trend_stop_minutes : signal_index + 1]
        extreme = float(stop_slice["low"].min() if side == 1 else stop_slice["high"].max())
        stop = extreme - side * config.trend_stop_buffer_atr * atr
        details = {
            "trend_240m_atr": trend,
            "pullback_15m_atr": pullback,
            "structure": structure,
            "body_atr": body,
            "flow_60s": flow,
            "notional_burst_60s": burst,
            "close_location": close_location,
            "oi_change_15m": oi_change,
            "absorption_60s": absorption,
            "efficiency_60s": efficiency,
            "flow_acceleration": acceleration,
        }
        intents.append(
            Intent(
                scenario="INVENTORY_BACKED_DISPLACEMENT",
                side=side,
                signal_index=signal_index,
                entry_index=signal_index + 1,
                stop_level=stop,
                event_indices=(signal_index,),
                details=details,
            ),
        )
        diagnostics.append({"index": signal_index, "time": timestamp, "side": side, **details})
    return cluster_intents(intents, config.parent_cluster_minutes), diagnostics


def target_trigger(
    entry_fill: float,
    side: int,
    loss_per_unit: float,
    target_r: float,
    config: Config,
) -> float:
    fee = config.fee_bps / 10_000.0
    slip = config.market_exit_slippage_bps / 10_000.0
