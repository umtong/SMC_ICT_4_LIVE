    hold_minutes: int
    cluster_events: int


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        while block := stream.read(1 << 20):
            digest.update(block)
    return digest.hexdigest()


def _download_checked(url: str, target: Path) -> Path:
    target.parent.mkdir(parents=True, exist_ok=True)
    checksum = target.with_suffix(target.suffix + ".CHECKSUM")
    if not target.exists():
        urllib.request.urlretrieve(url, target)
    if not checksum.exists():
        urllib.request.urlretrieve(url + ".CHECKSUM", checksum)
    expected = checksum.read_text(encoding="utf-8").strip().split()[0].lower()
    actual = sha256_file(target)
    if actual != expected:
        raise CandidateError(f"checksum mismatch for {target}: {actual} != {expected}")
    return target


def ensure_klines(symbol: str, start: date, end: date, root: Path) -> list[Path]:
    paths: list[Path] = []
    day = start
    while day <= end:
        name = f"{symbol}-1m-{day.isoformat()}.zip"
        url = f"{BASE}/klines/{symbol}/1m/{name}"
        paths.append(_download_checked(url, root / name))
        day += timedelta(days=1)
    return paths


def load_klines(paths: Iterable[Path]) -> pd.DataFrame:
    parts: list[pd.DataFrame] = []
    for path in sorted(paths):
        frame = pd.read_csv(path, compression="zip")
        if "open_time" not in frame.columns:
            frame = pd.read_csv(path, compression="zip", names=KLINE_COLUMNS)
        frame["open_time"] = pd.to_datetime(frame["open_time"], unit="ms", utc=True)
        for column in ("open", "high", "low", "close", "volume", "quote_volume"):
            frame[column] = pd.to_numeric(frame[column], errors="coerce")
        parts.append(frame.set_index("open_time"))
