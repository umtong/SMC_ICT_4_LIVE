+        )
+        self.assertIsNotNone(plan)
+        assert plan is not None
+        self.assertTrue(plan.details["post_confirmation_extension_confirmed"])
+        self.assertAlmostEqual(
+            plan.details["post_confirmation_extension_trough"],
+            88.5,
+        )
