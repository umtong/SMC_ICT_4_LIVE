def _finite(value: Any, default: float = 0.0) -> float:
    try:
        result = float(value)
    except (TypeError, ValueError):
        return default
    return result if math.isfinite(result) else default


def _sign(side: str) -> float:
    return 1.0 if side == "LONG" else -1.0


def _stable(*parts: Any) -> str:
    return hashlib.sha1("|".join(str(part) for part in parts).encode("utf-8")).hexdigest()[:16]


def _atr_price(data: pd.DataFrame, index: int, window: int = 90) -> float:
    start = max(1, index - window)
    frame = data.iloc[start:index + 1]
    if frame.empty:
        return max(abs(float(data.iloc[index].close)) * 1e-5, EPS)
    previous = frame.close.shift(1)
    true_range = pd.concat(
        [
            (frame.high - frame.low).abs(),
            (frame.high - previous).abs(),
            (frame.low - previous).abs(),
        ],
        axis=1,
    ).max(axis=1)
    value = _finite(true_range.iloc[:-1].median() if len(true_range) > 1 else true_range.median())
    return max(value, abs(float(data.iloc[index].close)) * 1e-6, EPS)


def _signed_flow(frame: pd.DataFrame) -> pd.Series:
    quote = pd.to_numeric(frame.get("quote_volume", pd.Series(0.0, index=frame.index)), errors="coerce").fillna(0.0)
    if "signed_quote_flow" in frame:
        return pd.to_numeric(frame.signed_quote_flow, errors="coerce").fillna(0.0)
    if "taker_buy_quote_volume" in frame:
        buy = pd.to_numeric(frame.taker_buy_quote_volume, errors="coerce").fillna(0.0)
        return 2.0 * buy - quote
    if "delta_share" in frame:
        share = pd.to_numeric(frame.delta_share, errors="coerce").fillna(0.0)
        return share * quote
    return pd.Series(0.0, index=frame.index)


def _activity_baseline(data: pd.DataFrame, index: int) -> float:
    if "quote_volume" not in data:
        return 1.0
    values = pd.to_numeric(data.quote_volume.iloc[max(0, index - 180):index], errors="coerce").replace(0.0, np.nan)
    return max(_finite(values.median(), 1.0), EPS)


def _path_efficiency(closes: np.ndarray, sign: float) -> float:
    if len(closes) < 2:
        return 0.0
    travel = float(np.abs(np.diff(closes)).sum())
    return sign * float(closes[-1] - closes[0]) / max(travel, EPS)


