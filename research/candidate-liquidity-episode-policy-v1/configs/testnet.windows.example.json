{
  "mode": "testnet",
  "symbols": ["BTCUSDT", "ETHUSDT", "SOLUSDT", "XRPUSDT"],
  "state_dir": "runtime/episode-policy-testnet",
  "model_bundle": "runtime/model/model_bundle.joblib",
  "binance_http_base": "https://testnet.binancefuture.com",
  "poll_seconds": 15.0,
  "decision_interval_minutes": 5,
  "initial_backfill_days": 14,
  "rolling_window_days": 14,
  "request_timeout_seconds": 12.0,
  "request_retries": 4,
  "starting_balance_usdt": 100000.0,
  "risk_fraction": 0.03,
  "maximum_leverage": 3.0,
  "minimum_notional_usdt": 10.0,
  "entry_expiry_minutes": 45,
  "heartbeat_seconds": 30,
  "require_model_bundle_for_orders": true,
  "allow_testnet_orders": true,
  "close_positions_on_stop": false,
  "external_order_claims": true,
  "log_level": "INFO",
  "metadata": {
    "purpose": "Binance USD-M Futures testnet only",
    "credentials_expected": true,
    "required_environment": ["BINANCE_API_KEY", "BINANCE_API_SECRET"]
  }
}
