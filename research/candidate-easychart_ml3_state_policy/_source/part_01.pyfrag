        np.log1p(frame["quote_volume"] / frame["count"].clip(lower=1)),
        240,
    )
    out["impact_per_flow_5"] = _safe_div(out["ret_5"], out["flow_5"].abs() + 0.025).clip(-0.2, 0.2)
    out["impact_per_flow_15"] = _safe_div(out["ret_15"], out["flow_15"].abs() + 0.025).clip(-0.3, 0.3)
    out["flow_price_agreement_5"] = np.sign(out["ret_5"] * out["flow_5"])
    out["absorption_5"] = out["flow_z_5"].abs() - _rolling_z(out["ret_5"].abs(), 240).abs()

    abs_ret = ret1.abs()
    for horizon in (15, 30, 60, 120):
        travel = abs_ret.rolling(horizon, min_periods=max(8, horizon // 2)).sum()
        out[f"efficiency_{horizon}"] = _safe_div(out[f"ret_{horizon}"].abs(), travel).clip(0.0, 1.0)

    for horizon in (15, 30, 60, 120, 240, 480):
        prior_high = frame["high"].shift(1).rolling(horizon, min_periods=max(10, horizon // 2)).max()
        prior_low = frame["low"].shift(1).rolling(horizon, min_periods=max(10, horizon // 2)).min()
        width = (prior_high - prior_low).clip(lower=1e-12)
        out[f"prior_high_{horizon}"] = prior_high
        out[f"prior_low_{horizon}"] = prior_low
        out[f"range_width_pct_{horizon}"] = width / frame["close"]
        out[f"range_pos_{horizon}"] = ((frame["close"] - prior_low) / width).clip(-2.0, 3.0)
        out[f"dist_high_atr_{horizon}"] = (prior_high - frame["close"]) / out["atr_60"].clip(lower=1e-12)
        out[f"dist_low_atr_{horizon}"] = (frame["close"] - prior_low) / out["atr_60"].clip(lower=1e-12)

    range15 = frame["high"].rolling(15, min_periods=10).max() - frame["low"].rolling(15, min_periods=10).min()
    range60 = frame["high"].rolling(60, min_periods=30).max() - frame["low"].rolling(60, min_periods=30).min()
    out["compression_15"] = _safe_div(range15, range15.rolling(240, min_periods=60).median())
    out["compression_60"] = _safe_div(range60, range60.rolling(720, min_periods=180).median())

    typical = (frame["high"] + frame["low"] + frame["close"]) / 3.0
    for horizon in (30, 120, 480):
        qv = frame["quote_volume"].rolling(horizon, min_periods=max(10, horizon // 2)).sum()
        vwap = (typical * frame["quote_volume"]).rolling(horizon, min_periods=max(10, horizon // 2)).sum() / qv.clip(lower=1e-12)
        out[f"vwap_dev_atr_{horizon}"] = (frame["close"] - vwap) / out["atr_60"].clip(lower=1e-12)

    # Continuous auction-event descriptors.  These are features, not entry gates.
    low60 = out["prior_low_60"]
    high60 = out["prior_high_60"]
    out["sweep_reclaim_low_60"] = ((frame["low"] < low60) & (frame["close"] > low60)).astype(float)
    out["sweep_reclaim_high_60"] = ((frame["high"] > high60) & (frame["close"] < high60)).astype(float)
    out["accepted_break_high_60"] = ((frame["close"] > high60) & (frame["low"] > low60)).astype(float)
    out["accepted_break_low_60"] = ((frame["close"] < low60) & (frame["high"] < high60)).astype(float)
    out["break_distance_high_atr"] = (frame["close"] - high60) / out["atr_60"].clip(lower=1e-12)
    out["break_distance_low_atr"] = (low60 - frame["close"]) / out["atr_60"].clip(lower=1e-12)
    return out


def build_feature_frames(frames: Mapping[str, pd.DataFrame]) -> dict[str, pd.DataFrame]:
    aligned = align_universe(frames)
    base = {symbol: _single_symbol_features(aligned[symbol]) for symbol in SYMBOLS}
    index = base[SYMBOLS[0]].index

    ret1 = pd.DataFrame({symbol: base[symbol]["ret_1"] for symbol in SYMBOLS}, index=index)
    flow1 = pd.DataFrame({symbol: base[symbol]["flow_1"] for symbol in SYMBOLS}, index=index)
    factor_ret1 = ret1.mean(axis=1)
    factor_flow1 = flow1.mean(axis=1)
    factor_log = factor_ret1.fillna(0.0).cumsum()
    factor_high60 = factor_log.shift(1).rolling(60, min_periods=30).max()
    factor_low60 = factor_log.shift(1).rolling(60, min_periods=30).min()

    for symbol in SYMBOLS:
        out = base[symbol]
        factor_var = factor_ret1.rolling(240, min_periods=120).var(ddof=0).clip(lower=1e-12)
        beta = out["ret_1"].rolling(240, min_periods=120).cov(factor_ret1) / factor_var
        beta = beta.clip(-1.0, 3.0)
        residual1 = out["ret_1"] - beta * factor_ret1
        out["factor_beta_240"] = beta
        out["residual_1"] = residual1
        for horizon in (5, 15, 30, 60, 120):
            factor_h = factor_ret1.rolling(horizon, min_periods=max(2, horizon // 2)).sum()
            residual_h = residual1.rolling(horizon, min_periods=max(2, horizon // 2)).sum()
            out[f"factor_ret_{horizon}"] = factor_h
            out[f"factor_breadth_{horizon}"] = np.sign(
                pd.DataFrame({s: base[s][f"ret_{horizon}"] for s in SYMBOLS}, index=index)
            ).mean(axis=1)
            out[f"factor_dispersion_{horizon}"] = pd.DataFrame(
                {s: base[s][f"ret_{horizon}"] for s in SYMBOLS}, index=index
            ).std(axis=1, ddof=0)
            out[f"residual_{horizon}"] = residual_h
            out[f"residual_z_{horizon}"] = _rolling_z(residual_h, 480)
        out["factor_flow_5"] = factor_flow1.rolling(5, min_periods=3).mean()
        out["factor_flow_15"] = factor_flow1.rolling(15, min_periods=8).mean()
        out["relative_flow_15"] = out["flow_15"] - out["factor_flow_15"]
        out["btc_lead_5"] = base["BTCUSDT"]["ret_5"] - out["ret_5"]
        out["btc_lead_15"] = base["BTCUSDT"]["ret_15"] - out["ret_15"]
        out["factor_impulse_z_15"] = _rolling_z(out["factor_ret_15"], 480)
        out["factor_range_pos_60"] = ((factor_log - factor_low60) / (factor_high60 - factor_low60).clip(lower=1e-12)).clip(-2.0, 3.0)
        out["factor_range_width_60"] = factor_high60 - factor_low60
        out["factor_anchor_high_60"] = factor_high60
        out["factor_anchor_low_60"] = factor_low60

        minute = out.index.minute + 60 * out.index.hour
        angle = 2.0 * math.pi * minute / 1440.0
        out["tod_sin"] = np.sin(angle)
        out["tod_cos"] = np.cos(angle)
        out["dow_sin"] = np.sin(2.0 * math.pi * out.index.dayofweek / 7.0)
        out["dow_cos"] = np.cos(2.0 * math.pi * out.index.dayofweek / 7.0)
        base[symbol] = out.replace([np.inf, -np.inf], np.nan)
    return base


