def _round_anchor(value: float) -> str:
    if not math.isfinite(value):
        return "NA"
    return f"{value:.8g}"


def _episode_id(symbol: str, side: int, row: pd.Series) -> tuple[str, str]:
    local = (
        f"{symbol}:{side}:"
        f"{_round_anchor(float(row['prior_high_60']))}:"
        f"{_round_anchor(float(row['prior_low_60']))}"
    )
    global_id = (
        f"{side}:"
        f"{_round_anchor(float(row['factor_anchor_high_60']))}:"
        f"{_round_anchor(float(row['factor_anchor_low_60']))}"
    )
    return local, global_id


def _action_geometry(
    symbol: str,
    template: str,
    side: int,
    row: pd.Series,
    cost: CostModel,
) -> tuple[float, float, int] | None:
    close = float(row["close"])
    atr = float(row["atr_60"])
    if not (math.isfinite(close) and math.isfinite(atr) and close > 0.0 and atr > 0.0):
        return None
    planned_entry = close * (1.0 + side * cost.entry_slippage)
    tick = TICK_SIZE[symbol]
    buffer = max(0.15 * atr, 2.0 * tick)

    if side > 0:
        local_stop_distance = planned_entry - (float(row["prior_low_30"]) - buffer)
        broad_stop_distance = planned_entry - (float(row["prior_low_120"]) - buffer)
        local_target_distance = float(row["prior_high_60"]) - planned_entry
        broad_target_distance = float(row["prior_high_240"]) - planned_entry
    else:
        local_stop_distance = (float(row["prior_high_30"]) + buffer) - planned_entry
        broad_stop_distance = (float(row["prior_high_120"]) + buffer) - planned_entry
        local_target_distance = planned_entry - float(row["prior_low_60"])
        broad_target_distance = planned_entry - float(row["prior_low_240"])

    local_stop_distance = max(local_stop_distance, 1.10 * atr, 4.0 * tick)
    broad_stop_distance = max(broad_stop_distance, 1.50 * atr, 4.0 * tick)
    range60 = max(float(row["prior_high_60"]) - float(row["prior_low_60"]), atr)
    residual_repair = max(abs(float(row["residual_60"])) * planned_entry * 0.75, 0.80 * atr)

    if template == "FAST_BALANCE":
        stop_distance, target_distance, horizon = 1.20 * atr, 1.05 * 1.20 * atr, 45
    elif template == "BASE_ASYMMETRIC":
        stop_distance, target_distance, horizon = 1.65 * atr, 1.55 * 1.65 * atr, 120
    elif template == "LOCAL_STRUCTURE":
        stop_distance = local_stop_distance
        target_distance = max(local_target_distance, 0.80 * stop_distance)
        horizon = 120
    elif template == "BROAD_STRUCTURE":
        stop_distance = broad_stop_distance
        target_distance = max(broad_target_distance, 0.90 * stop_distance)
        horizon = 240
    elif template == "RESIDUAL_REPAIR":
        stop_distance = max(1.35 * atr, 4.0 * tick)
        target_distance = max(residual_repair, 0.75 * stop_distance)
        horizon = 120
    elif template == "RANGE_EXTENSION":
        stop_distance = local_stop_distance
        target_distance = max(0.65 * range60, 1.10 * stop_distance)
        horizon = 180
    else:
        raise ValueError(template)

    stop_distance = max(stop_distance, 4.0 * tick)
    target_distance = max(target_distance, 4.0 * tick)
    stop = planned_entry - side * stop_distance
    target = planned_entry + side * target_distance
    if stop <= 0.0 or target <= 0.0:
        return None
    gross_rr = target_distance / stop_distance
    stop_pct = stop_distance / planned_entry
    target_pct = target_distance / planned_entry
    if not (0.0008 <= stop_pct <= 0.035 and 0.0005 <= target_pct <= 0.08 and 0.45 <= gross_rr <= 5.0):
        return None
    return stop, target, horizon


def enumerate_candidates(
    feature_frames: Mapping[str, pd.DataFrame],
    config: PolicyConfig,
    cost: CostModel,
) -> pd.DataFrame:
    """Enumerate the dense state-action surface without Python row loops."""
    pieces: list[pd.DataFrame] = []
    repeats_per_state = 2 * len(ACTION_TEMPLATES)
    for symbol in SYMBOLS:
        frame = feature_frames[symbol]
