@dataclass(frozen=True, slots=True)
class CostModel:
    entry_taker_rate: float = 0.00050
    stop_taker_rate: float = 0.00050
    time_taker_rate: float = 0.00050
    target_maker_rate: float = 0.00020
    entry_slippage_bps: float = 2.0
    stop_slippage_bps: float = 2.0
    time_slippage_bps: float = 2.0
    adverse_funding_per_8h: float = 0.00010

    @property
    def entry_slippage(self) -> float:
        return self.entry_slippage_bps / 10_000.0

    @property
    def stop_slippage(self) -> float:
        return self.stop_slippage_bps / 10_000.0

    @property
    def time_slippage(self) -> float:
        return self.time_slippage_bps / 10_000.0


@dataclass(frozen=True, slots=True)
class PolicyConfig:
    decision_step_minutes: int = 5
    risk_fraction: float = 0.03
    max_leverage: float = 20.0
    warmup_minutes: int = 720
    calibration_bins: int = 16
    random_state: int = 9417


@dataclass(slots=True)
class CalibrationMap:
    lower_edges: np.ndarray
    upper_edges: np.ndarray
    raw_centers: np.ndarray
    means: np.ndarray
    lower_means: np.ndarray
    counts: np.ndarray
    isotonic: IsotonicRegression

    def predict_mean(self, raw_score: np.ndarray) -> np.ndarray:
        return np.asarray(self.isotonic.predict(raw_score), dtype=float)

    def predict_lower(self, raw_score: np.ndarray) -> np.ndarray:
        if len(self.raw_centers) == 1:
            return np.full_like(raw_score, self.lower_means[0], dtype=float)
        return np.interp(
            raw_score,
            self.raw_centers,
            self.lower_means,
            left=self.lower_means[0],
            right=self.lower_means[-1],
        )


@dataclass(slots=True)
class ModelBundle:
    feature_columns: tuple[str, ...]
    reg_hist: object
    reg_extra: object
    clf_hist: object
    clf_extra: object
    calibration: CalibrationMap
    calibration_diagnostics: dict[str, object]


